# Режим: development | test | production
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# В production используется PostgreSQL. Значения ниже — примеры, не реальные секреты.
POSTGRES_DB=travel_revenue_ai
POSTGRES_USER=travel_revenue
POSTGRES_PASSWORD=replace_with_a_strong_password
DATABASE_URL=postgresql+psycopg://travel_revenue:replace_with_a_strong_password@postgres:5432/travel_revenue_ai

# Обязательно для production. Сгенерировать:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=replace_with_a_fernet_key

# JSON-массив разрешённых origins, без "*" в production.
CORS_ORIGINS=["http://localhost:8080"]

MORNING_BRIEF_RUN_TIME=08:00
MORNING_BRIEF_TIMEZONE=Europe/Moscow
FRONTEND_PORT=8080

# Development example:
# ENVIRONMENT=development
# DATABASE_URL=sqlite:///./travel_revenue_ai.db
#
# Test example:
# ENVIRONMENT=test
# DATABASE_URL=sqlite:///./travel_revenue_ai_test.db