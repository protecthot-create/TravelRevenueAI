# Travel Revenue AI — переменные окружения

# Приложение
APP_NAME="Travel Revenue AI"
APP_VERSION="0.1.0"
DEBUG=false

# Сервер
HOST=0.0.0.0
PORT=8000

# API
API_PREFIX=/api/v1

# CORS (через запятую)
CORS_ORIGINS=*

# База данных
# SQLite для MVP (по умолчанию):
DATABASE_URL=sqlite:///./travel_revenue_ai.db
# PostgreSQL для production:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/travel_revenue_ai

# Пул соединений (только для PostgreSQL)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Планировщик Morning Brief
# Формат времени: HH:MM. Сам по себе фоновые задачи не запускает.
MORNING_BRIEF_RUN_TIME=08:00
MORNING_BRIEF_TIMEZONE=Europe/Moscow
