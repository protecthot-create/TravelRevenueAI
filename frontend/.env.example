# Базовый URL FastAPI API вместе с префиксом версии, например http://localhost:8000/api/v1.
# В docker compose значение передаётся build-arg'ом (/api/v1) и подставляется на этапе сборки.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Publishable key Clerk. Публичное значение, но реальный ключ в репозиторий не коммитим:
# заполняется в локальном .env (не в Git).
VITE_CLERK_PUBLISHABLE_KEY=
